# ---- Secrets / credentials (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/

# ---- Python / tooling ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Pipeline run outputs (regenerated by `make run` into data/output/) ----
# Includes llm_raw/ (full prompts + model output) and llm_cache/ (replay cache).
# To commit a replayable run, un-ignore data/output/llm_cache/ explicitly.
data/output/
scratch/

# ---- OS / editors ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- Process state for scripts/start.sh & stop.sh ----
.run/
